# Bridge process (no Colanode account secrets here — use /admin)
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8786
BRIDGE_MODE=http
BRIDGE_SECRET=change-me-to-a-long-random-secret
PUBLIC_BASE_URL=https://colanode-mcp.example.com

# Local data (Docker volume mounts /data)
COLANODE_DATA_DIR=./data
# COLANODE_ASSETS_DIR=./vendor/colanode/assets

# Sidecar (started by the Python process)
SIDECAR_URL=http://127.0.0.1:3921
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=3921
SIDECAR_AUTO_START=true

# MCP streamable HTTP DNS-rebinding protection (enable only with tight Host allowlists)
MCP_DNS_REBINDING_PROTECTION=false

# Optional: MCP stdio binds this store account (default = master)
# SC_ACCOUNT_ID=acc_...
