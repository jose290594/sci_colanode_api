{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@colanode/client/*": ["../vendor/colanode/packages/client/src/*"],
      "@colanode/core": ["../vendor/colanode/packages/core/src/index.ts"],
      "@colanode/core/*": ["../vendor/colanode/packages/core/src/*"],
      "@colanode/crdt": ["../vendor/colanode/packages/crdt/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
